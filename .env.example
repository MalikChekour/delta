# ---------------------------------------------------------------------------
# Hermes — configuration. Copier en .env puis completer.
# Le fichier .env est ignore par git : il ne doit jamais etre versionne.
# ---------------------------------------------------------------------------

# --- Telegram --------------------------------------------------------------
# Token donne par @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Identifiants numeriques Telegram autorises, separes par des virgules.
# Demande le tien a @userinfobot. Hermes execute du code : sans liste blanche,
# quiconque trouve le bot obtient un shell sur cette machine.
HERMES_ALLOWED_USERS=

# Alternative au demarrage : le premier a envoyer /start devient proprietaire,
# et lui seul. Envoie /start immediatement apres avoir lance le bot, puis
# reporte l'identifiant affiche dans HERMES_ALLOWED_USERS.
HERMES_CLAIM_OWNER=0

# Au redemarrage, ignorer les messages recus pendant l'arret (0 = les traiter).
HERMES_DROP_PENDING=0

# Prevenir le proprietaire au demarrage et a l'arret du service.
HERMES_ANNOUNCE=1

# --- Modeles ---------------------------------------------------------------
# Chaine de modeles, du prefere au repli. Voir `hermes models`.
HERMES_MODEL=glm-4.7-heretic,venice

# Cles des fournisseurs : une seule suffit.
VENICE_API_KEY=
OPENROUTER_API_KEY=
CHUTES_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Serveur local compatible OpenAI (vLLM, Ollama, LM Studio) : rien a renseigner,
# Hermes detecte le port et prefere le local quand il tourne.
# HERMES_CUSTOM_BASE_URL=http://192.168.1.20:8000/v1
# CUSTOM_API_KEY=

# --- Recherche web --------------------------------------------------------
# Hermes essaie plusieurs moteurs dans l'ordre et garde le premier qui repond.
# En 'auto' (defaut), les moteurs avec cle passent devant, puis DuckDuckGo.
#
# Pour une recherche vraiment fiable (jamais bloquee), renseigne UNE de ces
# options — c'est le principal levier de qualite :
# TAVILY_API_KEY=            # https://tavily.com — API concue pour les agents
# BRAVE_API_KEY=             # https://brave.com/search/api
# HERMES_SEARXNG_URL=        # ton instance SearXNG, ex : https://searx.exemple.fr
#
# Ordre explicite si besoin : HERMES_SEARCH_BACKENDS=brave,searxng,ddg_lite,ddg_html
# HERMES_SEARCH_BACKENDS=auto

# --- Comportement ----------------------------------------------------------
# HERMES_TEMPERATURE=0.7
# HERMES_MAX_TOKENS=8192
# HERMES_MAX_TOOL_ITERATIONS=20
# HERMES_HISTORY_MESSAGES=60
# HERMES_EXEC_TIMEOUT=120
# HERMES_OUTPUT_LIMIT=12000
# HERMES_REQUEST_TIMEOUT=300
# HERMES_WORKSPACE=./workspace
# HERMES_DATA_DIR=./data
# HERMES_ENABLE_SHELL=1
# HERMES_ENABLE_WEB=1
# HERMES_SYSTEM_PROMPT_FILE=./prompt.txt
# HERMES_LOG_LEVEL=INFO
