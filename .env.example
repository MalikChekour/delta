# ============================================================================
#  Hermes — configuration. Copier en `.env` puis remplir.
# ============================================================================

# --- Telegram (obligatoire) -------------------------------------------------
# Obtenir le token : ouvrir Telegram -> parler a @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=

# Identifiants numeriques autorises, separes par des virgules.
# Obtenir le tien : parler a @userinfobot sur Telegram.
# OBLIGATOIRE : Hermes execute du code sur cette machine.
HERMES_ALLOWED_USERS=

# --- Choix du modele --------------------------------------------------------
# Fournisseurs : ollama | lmstudio | vllm | openrouter | deepseek | venice |
#                xai | groq | together | fireworks | mistral | openai |
#                anthropic | custom
HERMES_PROVIDER=openrouter
HERMES_MODEL=deepseek/deepseek-chat

# --- Cles d'API : ne remplir que celle du fournisseur choisi -----------------
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
VENICE_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Endpoint maison compatible OpenAI (HERMES_PROVIDER=custom)
HERMES_CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# --- Recherche web ----------------------------------------------------------
# auto | tavily | brave | searxng | duckduckgo
# `auto` prend la premiere cle disponible, sinon DuckDuckGo (sans cle).
HERMES_SEARCH_BACKEND=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=

# --- Comportement de l'agent ------------------------------------------------
HERMES_MAX_TOKENS=8192
HERMES_MAX_TOOL_ITERATIONS=25
HERMES_HISTORY_TURNS=40
HERMES_TEMPERATURE=
HERMES_REQUEST_TIMEOUT=600

# Prompt systeme : par defaut celui de hermes/config.py.
# Pour le remplacer entierement, pointer un fichier :
HERMES_SYSTEM_PROMPT_FILE=

# Reflexion adaptative cote Anthropic : adaptive (defaut) | off
HERMES_THINKING=adaptive

# --- Execution --------------------------------------------------------------
HERMES_WORKSPACE=./workspace
HERMES_DATA_DIR=./data
HERMES_EXEC_TIMEOUT=120
HERMES_OUTPUT_LIMIT=12000
HERMES_ALLOW_NETWORK_IN_TOOLS=true
