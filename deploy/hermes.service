# Installation :
#   sudo cp deploy/hermes.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hermes
# Journaux :
#   journalctl -u hermes -f

[Unit]
Description=Hermes - agent Telegram autonome
Documentation=https://github.com/MalikChekour/delta
After=network-online.target
Wants=network-online.target

# Ne pas boucler indefiniment sur une panne de fond (ces cles vont dans [Unit]).
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple

# Adapter ces trois lignes a l'installation.
User=hermes
WorkingDirectory=/opt/hermes
ExecStart=/opt/hermes/.venv/bin/python -m hermes

EnvironmentFile=/opt/hermes/.env

# Refuse de demarrer si la configuration est cassee : mieux vaut un service
# en echec visible qu'un bot silencieusement muet.
ExecStartPre=/opt/hermes/.venv/bin/python -m hermes --check

Restart=always
RestartSec=10

# Durcissement : l'agent execute du code, on limite ce qu'il atteint.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hermes/workspace /opt/hermes/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes

[Install]
WantedBy=multi-user.target
