# Secrets — ne jamais versionner
.env
*.env
!.env.example
# Jeton partage entre l'agent et la passerelle « mains ». Il est cree a la volee au
# premier lancement : le versionner reviendrait a publier la cle du guichet qui commande
# la souris et le clavier de la machine.
.mains_jeton

# Donnees d'execution
data/
workspace/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# Sauvegardes locales du .env et caches de l'agent
.env.bak.*
workspace/.hermes_cache/
workspace/.hermes_savoir/
